default partial alphanumeric_keys
xkb_symbols "basic" {
    include "us(colemak)"

    name[Group1] = "English (Canary Ortho Q)";

    key <AD02> { [            l,            L,         lstroke,          Lstroke ] };
    key <AD03> { [            y,            Y,      udiaeresis,       Udiaeresis ] };
    key <AD05> { [            b,            B,      dead_breve,       asciitilde ] };
    key <AD06> { [            z,            Z,              ae,               AE ] };
    key <AD07> { [            f,            F,          atilde,           Atilde ] };
    key <AD08> { [            o,            O,          oacute,           Oacute ] };
    key <AD09> { [            u,            U,          uacute,           Uacute ] };

    key <AC01> { [            c,            C,        ccedilla,         Ccedilla ] };
    key <AC05> { [            g,            G,     dead_ogonek,       asciitilde ] };
    key <AC06> { [            m,            M,     dead_macron,       asciitilde ] };
    key <AC10> { [            a,            A,          aacute,           Aacute ] };

    key <AB01> { [            w,            W,           aring,            Aring ] };
    key <AB02> { [            j,            J,         dstroke,          Dstroke ] };
    key <AB03> { [            v,            V,              oe,               OE ] };
    key <AB04> { [            d,            D,  dead_diaeresis,       asciitilde ] };
    key <AB05> { [            k,            K,  dead_abovering,       asciitilde ] };
    key <AB06> { [            x,            X, dead_circumflex,       asciitilde ] };
    key <AB07> { [            h,            H,      dead_caron,       asciitilde ] };
};
